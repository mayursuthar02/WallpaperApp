{
  "expo": {
    "name": "Wallbit",
    "slug": "Wallbit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/appIcon.png",
    "scheme": "Wallbit",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#111111"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.wallbit.wallpaper",
      "icon": "./assets/images/appIcon.png",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "We need access to save wallpapers to your gallery"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.wallbit.wallpaper",
      "permissions": ["READ_MEDIA_IMAGES", "WRITE_EXTERNAL_STORAGE"],
      "icon": "./assets/images/appIcon.png"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/appIcon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow access to save wallpapers",
          "savePhotosPermission": "Allow saving wallpapers",
          "isAccessMediaLocationEnabled": true
        }
      ],

      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111111",
          "android": {
            "image": "./assets/images/appIcon.png",
            "imageWidth": 150
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
